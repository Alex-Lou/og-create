# Réglages de l'API de Brumelune sur le VPS. À copier en /etc/brumelune/api.env (lisible par root et brumelune
# seulement : chmod 640), puis remplir les deux valeurs « À REMPLACER ». Ne jamais committer le vrai fichier.
NODE_ENV=production
PORT=3000

# La base PostgreSQL du VPS (le mot de passe choisi à la création de l'utilisateur brumelune)
DATABASE_URL=postgres://brumelune:À REMPLACER@localhost:5432/brumelune

# Secret de signature des sessions : au moins 32 caractères, à générer avec `openssl rand -hex 32`. Le changer
# déconnecte tous les joueurs
JWT_SECRET=À REMPLACER

# L'adresse du jeu : origine autorisée, et liens envoyés par mail (nouveau mot de passe)
CORS_ORIGIN=https://brumelune.eu
APP_URL=https://brumelune.eu

# Un seul relais devant l'API (Nginx) : l'adresse du joueur est lue correctement pour les limites de requêtes
TRUST_PROXY_HOPS=1

# Formulaire de contact et mails de mot de passe (facultatif)
# EMAIL_USER=
# EMAIL_PASSWORD=
