# MODÈLE pour l'autre app du VPS (MemoCat, dépôt Usy2) : remplacer AUTRE-DOMAINE.fr par son domaine, partout.
# Elle tourne dans Docker (réseau de la machine) et écoute le port 8080, fermé à l'extérieur par le pare-feu (voir
# deploy/ovh/README.md, « L'autre app »). Ce fichier ne sert qu'à la ranger derrière le même Nginx que Brumelune.

server {
    listen 80;
    listen [::]:80;
    server_name AUTRE-DOMAINE.fr www.AUTRE-DOMAINE.fr;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://AUTRE-DOMAINE.fr$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name AUTRE-DOMAINE.fr www.AUTRE-DOMAINE.fr;

    ssl_certificate /etc/letsencrypt/live/AUTRE-DOMAINE.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/AUTRE-DOMAINE.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Envois de fichiers : jusqu'à 11 Mo côté MemoCat (application.yml)
    client_max_body_size 12m;

    # Messagerie en direct (STOMP sur WebSocket, /ws) : la connexion reste ouverte
    location /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
